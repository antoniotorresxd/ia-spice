# Variables que consume docker-compose.yml. Copia este archivo a .env y
# rellénalo; .env no se versiona.
#
# Genera cada secreto con:  openssl rand -hex 32

# --- Secretos entre subsistemas -------------------------------------------
# Con el que el servidor llama a agents (POST /runs).
AGENTS_API_TOKEN=
# Con el que agents consulta al servidor su configuración de LLM.
# Va en la dirección contraria y es un secreto distinto a propósito: si se
# filtra uno, el otro sigue valiendo.
AGENTS_SERVICE_TOKEN=

# --- Base de datos de la API ----------------------------------------------
# Cadenas de Neon. El servidor usa el driver `neon-http`, que habla el
# protocolo HTTP de Neon y no el de un Postgres corriente, así que el servicio
# `postgres` del compose no sirve aquí: ese es para el checkpointer de agents.
DATA_BASE_URL=
DATA_BASE_URL_POOL=

# Cadena estandar de Postgres donde el grafo persiste sus checkpoints. Es la
# MISMA base de Neon que usa el resto del sistema: Neon habla tanto el
# protocolo HTTP que consume la API como el de Postgres que usa psycopg.
#
# Fijate en el search_path: las tablas del checkpointer van en su propio
# esquema, no en `public`. LangGraph trae su propio sistema de migraciones
# (diez, versionadas en checkpoint_migrations, alguna con ALTER TABLE), asi
# que si vivieran en `public` Drizzle las veria como deriva de su esquema y
# querria revertirlas. Cada sistema manda en el suyo.
#
# Usa el endpoint DIRECTO, no el `-pooler`: el pooler de Neon corre PgBouncer
# en modo transaccion y psycopg prepara sentencias por omision, combinacion que
# falla de forma intermitente.
#
#   postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&options=-c%20search_path%3Dagents
#
# Sin esta variable el grafo funciona igual, pero una corrida interrumpida se
# pierde en lugar de poder retomarse.
#
# Las tablas se crean una sola vez. Desde la raiz del workspace, junto con las
# migraciones de la API:
#   bun run db:setup
CHECKPOINTER_URL=

# --- Autenticación y cifrado ----------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Clave con la que se cifran en reposo las API keys de los proveedores de LLM.
LLM_SECRETS_KEY=

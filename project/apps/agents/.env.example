# Copia este archivo a .env y rellena los valores.
#
# OJO: uv no carga .env automaticamente. Pasalo de forma explicita:
#   uv run --env-file .env pytest
# Sin estas variables el pipeline sigue funcionando por la via del
# circuit_spec estructurado; lo unico que se desactiva es la entrada en
# lenguaje natural (request_text).

# --- Conexion con el server ---
# El LLM activo NUNCA se configura aqui: se resuelve llamando al catalogo del
# server en GET /api/internal/llm/active. Estas dos variables son las que
# permiten esa llamada.
# AGENTS_SERVICE_TOKEN debe ser identico al de project/apps/server/.env
SERVER_BASE_URL=http://localhost:3001
AGENTS_SERVICE_TOKEN=

# --- LangSmith (opcional, solo para trazas) ---
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT="Spice"

# Solo para tests: usuario contra el que corre la prueba live del LLM.
# uv run pytest tests/test_llm_live.py -m live_llm
LIVE_LLM_USER_ID=

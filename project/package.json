{
  "name": "spice",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:client": "bun run --cwd apps/client dev",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "start:client": "bun run --cwd apps/client preview --host 0.0.0.0 --port $PORT",
    "typecheck:server": "bun run --cwd apps/server typecheck",
    "build:server-types": "bun run --cwd apps/server build:types",
    "build:client": "bun run --cwd apps/client build",
    "test:client": "bun run --cwd apps/client test",
    "lint:client": "bun run --cwd apps/client lint",
    "build:server": "bun run typecheck:server",
    "start:server": "bun run --cwd apps/server src/index.ts",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:setup:agents": "cd apps/agents && uv run --env-file .env python -m agents.checkpointer",
    "db:setup": "bun run db:migrate && bun run db:setup:agents"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
